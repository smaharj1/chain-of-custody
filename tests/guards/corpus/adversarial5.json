{"id": "adv5-004", "caller": "conductor", "repo": "feat", "cmd": "find .claude -execdir sh -c 'echo x > settings.json' \\;", "expect": "deny", "rule": "guard-file:settings", "why": "-execdir runs in the matched file's directory"},
{"id": "adv5-005", "caller": "conductor", "repo": "feat", "cmd": "git -C .claude checkout -- settings.json", "expect": "deny", "rule": "guard-file:settings", "why": "git -C moves the relative pathspec"},
