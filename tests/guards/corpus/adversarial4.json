{"id": "adv4-032", "caller": "unknown", "repo": "feat", "cmd": "python3 -m guards.run --selftest", "expect": "allow"},
{"id": "adv4-033", "caller": "unknown", "repo": "feat", "cmd": "echo '{\"session_id\":\"sess-unknown\",\"role\":\"conductor\"}' > .git/sessions/x.json", "expect": "deny", "rule": "guard-file:git"},
