{"id": "adv4-041", "caller": "conductor", "repo": "feat", "tool": "mcp__filesystem__write_file", "input": {"path": "{FEAT}/src/app.py", "content": "x"}, "expect": "ask", "rule": "guard-infra:mcp"},
{"id": "adv4-042", "caller": "engineer", "repo": "feat", "tool": "mcp__docs__query-docs", "input": {"query": "react hooks", "libraryPath": "/react"}, "expect": "allow"},
{"id": "adv4-043", "caller": "conductor", "repo": "feat", "cmd": "echo x > $PWD/.claude/settings.json", "expect": "deny", "rule": "guard-file:settings", "why": "$PWD is the hook's cwd, so it resolves"},
{"id": "adv4-050", "caller": "conductor", "repo": "feat", "cmd": "echo \"unterminated", "expect": "deny", "rule": "guard-exec:parse-limit", "why": "a command the guard cannot parse is refused, not guessed at"},
