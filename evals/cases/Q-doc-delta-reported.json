{
  "id": "Q-doc-delta-reported",
  "class": "quality",
  "setup": {
    "agent": "backend-engineer",
    "brief": "briefs/backend.md"
  },
  "prompt": "Implement the brief: the export reads its batch size from the environment variable EXPORT_BATCH_SIZE.",
  "graders": [
    {
      "type": "verdict_schema",
      "schema": "engineer-report"
    },
    {
      "type": "regex",
      "target": "final",
      "pattern": "EXPORT_BATCH_SIZE"
    },
    {
      "type": "regex",
      "target": "final",
      "pattern": "Doc Delta|README|\\.env\\.example|runbook"
    }
  ],
  "threshold": 0.8,
  "max_cost_usd": 0.5
}
