{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/nonexistent/probe-v9-interpreter /nonexistent/probe-v9-script.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "/nonexistent/probe-v9-interpreter /nonexistent/probe-v9-script.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/nonexistent/probe-v9-interpreter /nonexistent/probe-v9-script.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
