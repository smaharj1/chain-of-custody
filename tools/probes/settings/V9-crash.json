{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{HOOK}}\" crash --tag v9-crash-pretooluse --log \"{{LOG}}\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{HOOK}}\" crash --tag v9-crash-permissionrequest --log \"{{LOG}}\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{HOOK}}\" crash --tag v9-crash-configchange --log \"{{LOG}}\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
