{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "deniedCidrs": [
        "169.254.0.0/16",
        "fd00:ec2::254/128"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.ssh",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.azure",
        "~/.kube",
        "~/.docker",
        "~/.netrc",
        "~/.git-credentials",
        "~/.npmrc",
        "**/.env.production*",
        "**/*.pem",
        "**/*.key",
        ".git/loopctl/heldout"
      ],
      "denyWrite": [
        ".git/hooks",
        ".git/config",
        ".git/info",
        ".git/loopctl/sessions",
        ".claude/settings.json",
        ".claude/settings.local.json",
        ".claude/settings.v2.json",
        ".claude/settings*.json",
        ".claude/managed-settings.json",
        ".claude/hooks",
        ".claude/scripts",
        ".claude/agents",
        ".claude/skills",
        ".claude/commands",
        ".claude/rules",
        ".claude/workflows",
        ".claude/loop.config.md",
        ".claude/templates",
        ".claude-plugin",
        "plugin",
        ".mcp.json",
        ".mcp.*.json",
        ".github",
        ".gitlab-ci.yml",
        ".gitlab",
        ".circleci",
        "Jenkinsfile",
        "azure-pipelines.yml",
        ".buildkite",
        "bitbucket-pipelines.yml",
        ".travis.yml",
        "CODEOWNERS",
        "docs/CODEOWNERS"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(**/.env.production*)",
      "Edit(.git/hooks/**)",
      "Edit(.git/config)",
      "Edit(.git/info/**)",
      "Edit(.git/loopctl/sessions/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/settings.v2.json)",
      "Edit(.claude/settings*.json)",
      "Edit(.claude/managed-settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/scripts/**)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/commands/**)",
      "Edit(.claude/rules/**)",
      "Edit(.claude/workflows/**)",
      "Edit(.claude/loop.config.md)",
      "Edit(.claude/templates/**)",
      "Edit(.claude-plugin/**)",
      "Edit(plugin/**)",
      "Edit(.mcp.json)",
      "Edit(.mcp.*.json)",
      "Edit(.github/**)",
      "Edit(.gitlab-ci.yml)",
      "Edit(.gitlab/**)",
      "Edit(.circleci/**)",
      "Edit(Jenkinsfile)",
      "Edit(azure-pipelines.yml)",
      "Edit(.buildkite/**)",
      "Edit(bitbucket-pipelines.yml)",
      "Edit(.travis.yml)",
      "Edit(CODEOWNERS)",
      "Edit(docs/CODEOWNERS)",
      "Read(.git/loopctl/heldout/**)"
    ]
  }
}
